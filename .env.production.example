APP_NAME="HSB HR Dashboard"
APP_KEY=base64:REPLACE_WITH_A_RANDOM_32_BYTE_KEY
APP_URL=https://jobs.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_DATABASE=hsb_jobs
DB_USERNAME=hsb_jobs
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=jobs@example.com
MAIL_FROM_NAME="HSB HR Dashboard"

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8181
